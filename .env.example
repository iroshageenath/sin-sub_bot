# Telegram
BOT_TOKEN=
ADMIN_USER_ID=

# Gemini API keys: add up to 10 keys. Keys rotate on retryable key/API errors.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# Selected model. Available choices are controlled by AVAILABLE_MODELS.
DEFAULT_MODEL=gemini-3.1-flash-lite
AVAILABLE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-pro-preview,gemini-3-flash-preview,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite

# Bot limits
MAX_FILES=12
MAX_DOWNLOAD_MB=20
MAX_ZIP_MEMBERS=12
MAX_ZIP_UNCOMPRESSED_MB=250
MAX_ENTRIES_PER_CALL=50
MAX_CHARS_PER_CALL=12000
CONTEXT_ENTRIES=8
RETRY_PER_ATTEMPT=2
INTER_CALL_DELAY=1.2
RESULT_TTL_MINUTES=15
MAX_ERRORS_SHOWN=5
SEND_DELAY=0.7
AUTO_MODEL_FALLBACK=false  # Keep the bot on the selected model; rotate API keys only
DATA_DIR=data

# Optional: Telegram numeric chat ID for developer activity logs (e.g. -1001234567890)
DEV_GROUP_ID=
